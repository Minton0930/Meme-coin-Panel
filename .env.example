# Copy this file to .env and fill in what you have. Everything is optional,
# and the dashboard's SETTINGS box writes this file for you.

# Port for the dashboard (http://localhost:8787)
PORT=8787

# Your PUBLIC Solana wallet address, for the MY TRADES page (read-only).
# NEVER put a private key or seed phrase here. The app refuses them.
WALLET_ADDRESS=

# Solana RPC. The public endpoint works but is slow. A free Helius key is
# strongly recommended: SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# AI chat (paid per use, optional). https://console.anthropic.com
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-opus-5-5

# Names for the news radar (Google News headlines)
NEWS_TOPICS=Elon Musk,Donald Trump,CZ Binance,MrBeast,memecoin

# Optional keys that raise limits
RUGCHECK_TOKEN=
# Jupiter is moving its token API behind keys (developers.jup.ag). Without one the old keyless host is used.
JUPITER_API_KEY=

# Sources (1 = off / on)
DISABLE_PUMPPORTAL=0
# Reddit blocks keyless requests since May 2026, so it is off unless you turn it on
ENABLE_REDDIT=0
