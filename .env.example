# Copy this file to .env and fill in what you have. Everything is optional.

# Port for the dashboard (http://localhost:8787)
PORT=8787

# AI chat. Without this the chat panel is disabled; everything else works.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-opus-5-5

# Solana RPC. The public endpoint works but is heavily rate limited
# (holder lookups and wallet-age checks will be slow). A free Helius or
# QuickNode key is strongly recommended, e.g.
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional RugCheck API token (raises their limits). Public endpoints work without it.
RUGCHECK_TOKEN=

# Optional TikTok signal through Apify (paid per run, roughly cents per search).
# TikTok has no open public API, so without this TikTok is not searched.
APIFY_TOKEN=
APIFY_TIKTOK_ACTOR=clockworks~free-tiktok-scraper

# Turn individual sources off (1 = off)
DISABLE_PUMPPORTAL=0
DISABLE_REDDIT=0
